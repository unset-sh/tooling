{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "automerge": false,
  "github-actions": {
    "managerFilePatterns": [
      "/^workflows\\/(?:\\.github|[a-z0-9-]+)\\/[a-z-]+\\/[^/]+\\.yml$/"
    ]
  }
}
